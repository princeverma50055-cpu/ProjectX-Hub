    const desc = document.getElementById('desc').value.trim();

    if (!name) { alert('Please enter your name.'); return; }
    if (!email || !email.includes('@')) { alert('Please enter a valid email.'); return; }
    if (!service) { alert('Please select a service.'); return; }
    if (!desc) { alert('Please describe your project.'); return; }

    const btn = document.getElementById('applyBtn');
    btn.textContent = '⏳ Sending...';
    btn.classList.add('loading');

    const subject = encodeURIComponent(`[ProjectX HUB] New Project - ${service} | ${name}`);
    const body = encodeURIComponent(
`New Project Application — ProjectX HUB
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
