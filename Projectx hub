${desc}
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
Sent via ProjectX HUB App`
    );

    setTimeout(() => {
      window.location.href = `mailto:princeverma50055@gmail.com?subject=${subject}&body=${body}`;
